# Board: Waveshare ESP32-S3-A7670E-4G (ESP32-S3R8, 16 MB flash,
# 8 MB octal PSRAM in package). Applied on top of sdkconfig.defaults.

CONFIG_SPIRAM_MODE_OCT=y

# Console: UART0 only. The native USB of the ESP32-S3 is wired to the A7670E
# modem, so the USB-Serial-JTAG console is not reachable on this board.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Modem uplink (A7670E on the native USB port, docs/modem.md): PPP in lwIP,
# the USB hub between the S3 and the modem, and the esp-iot-solution modem
# driver's checks before a data call (more patience, weaker signal allowed:
# CSQ 5 is about -103 dBm).
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_MODEM_OPERATION_RETRY_TIMES=10
CONFIG_MODEM_RSSI_THRESHOLD=5

# TCP send and receive windows of 32 KB instead of 5.7 KB (4 MSS): the
# window, not the link, limited a video upload to ~50 KB/s over LTE (round
# trips of 60-100 ms) and a firmware download likewise (#154). lwIP buffers
# are in PSRAM (SPIRAM_TRY_ALLOCATE_WIFI_LWIP).
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
