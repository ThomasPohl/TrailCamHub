menu "TrailCamHub PoC"

choice HUB_PROFILE
    prompt "Use case profile"
    default HUB_PROFILE_ON_SITE if BOARD_TDONGLE || IDF_TARGET_ESP32P4
    default HUB_PROFILE_AUTONOMOUS
    help
        The board selects the hardware (pins, PSRAM, console); the profile
        selects the defaults that belong to the use case: when the hub reads
        the cameras and checks in with the backend, whether it sleeps in
        between, and how much it writes to the SD card. Every option that a
        profile sets can still be changed on its own. See
        docs/power-and-schedule.md.

config HUB_PROFILE_AUTONOMOUS
    bool "Autonomous (no one on site, battery, backend)"
    help
        Reads the cameras and checks in with the backend on a schedule and
        sleeps (deep sleep) in between. After a power-on or reset the hub
        stays awake for a few minutes for the web installer and the serial
        console. Default for the Waveshare ESP32-S3-A7670E-4G.

config HUB_PROFILE_ON_SITE
    bool "On site (person present, permanent power)"
    help
        Stays awake and waits for the button, the web UI or the serial
        console; no automatic reads or check-ins unless a schedule is set.
        Default for the T-Dongles and the ESP32-P4-NANO.

endchoice

config BOARD_TDONGLE_S3
    bool "LilyGO T-Dongle-S3 display and button"
    depends on IDF_TARGET_ESP32S3
    default n
    help
        Show the camera workflow status on the 0.96" display and use the
        button on the back (GPIO0) to search for the camera. Selected by
        sdkconfig.defaults.tdongle-s3.

config BOARD_TDONGLE_C5
    bool "LilyGO T-Dongle-C5 display and button"
    depends on IDF_TARGET_ESP32C5
    default n
    help
        Show the camera workflow status on the 0.96" display and use the
        button (GPIO28) to search for the camera. The display shares its
        SPI bus with the microSD card. Selected by
        sdkconfig.defaults.tdongle-c5.

config BOARD_TDONGLE
    bool
    default y if BOARD_TDONGLE_S3 || BOARD_TDONGLE_C5

config DONGLE_LED_BRIGHTNESS
    int "RGB LED brightness (0: off)"
    depends on BOARD_TDONGLE
    range 0 31
    default 0
    help
        The APA102 LED on the back of the dongle shows the phase in the
        colour of the display title (white idle, yellow searching and
        connecting, green connected, orange waiting for a retry) at this
        global brightness (1 is very dim, 31 the maximum). 0 keeps it off.

config CAMERA_WIFI_ENABLE_PAYLOAD_HEX
    string "Wi-Fi enable payload (hex)"
    default "42545F4B45595F4F4E"
    help
        Payload to write to characteristic 0x0002, separated by optional spaces,
        colons, or hyphens. The default is ASCII "BT_KEY_ON".

config CAMERA_BLE_RELEASE_AFTER_ACTIVATION
    bool "Release BLE after the camera Wi-Fi was activated"
    default y
    help
        Disconnect from the camera and shut down the NimBLE stack and the
        Bluetooth controller once the camera has returned its Wi-Fi
        credentials. This returns their memory for the camera session; BLE
        is started again for the next activation. Disable this if the
        camera turns off its access point when the BLE connection ends.

config CAMERA_UDP_LOG_PACKET_HEX
    bool "Log camera UDP packet contents as hex"
    default y
    help
        Compile the per-packet hex dump of every camera UDP packet that is
        sent or received, in addition to the one-line packet summary. Useful
        while investigating the camera protocol. Both the hex dump and the
        one-line summaries use the DEBUG level, so they stay off in a normal
        INFO build (and out of the bulk-transfer hot path); raise the
        "trailcamhub_udp" tag to DEBUG to see them. Disable this option to
        drop the hex dump from the build entirely.

config CAMERA_THUMBNAIL_SERIAL_PREVIEW
    bool "Print the first thumbnail of a session as Base64"
    default y
    help
        Log the first thumbnail of each session as Base64 lines between
        "THUMB" markers, which the browser installer's live view shows.
        About 33 KB of log per session; boards with a web UI can show the
        thumbnails from the SD card instead.

config CAMERA_SESSION_IDLE_TIMEOUT_S
    int "Close the camera session after this many seconds without progress"
    range 30 600
    default 60
    help
        The camera session is closed when the camera neither answered a
        request nor sent new media data for this long; its heartbeat answers
        and repeated or stray media frames do not count. This ends a session that waits for an answer that never
        comes, so the camera does not keep its Wi-Fi on until its battery is
        empty. Keep it above the download stall timeout.

config CAMERA_MEDIA_LIST_MAX_PAGES
    int "Media-list pages read per camera session"
    range 1 1000
    default 20
    help
        The camera hands out its media list in pages of 45 files, newest
        first. A scan reads the pages until the list ends or this many pages
        were read (20 pages = 900 files). Each page is a request over the
        camera's Wi-Fi and the hub keeps the catalog in RAM, so a card with
        more files is read only up to its newest ones; older files are
        neither fetched nor requested. Listing only (camlist) is not limited
        by this.

config DIAG_MEMORY_LOG_INTERVAL_S
    int "Memory log interval (seconds)"
    range 0 3600
    default 30
    help
        Log free and minimum free heap for internal RAM and PSRAM at this
        interval. Set to 0 to log memory only at fixed workflow stages.

menu "Session"

config SESSION_BLE_ACTIVATION_TIMEOUT_S
    int "Camera BLE activation timeout (seconds)"
    range 10 600
    default 90
    help
        Time allowed for finding the camera over BLE and receiving its Wi-Fi
        credentials after a scan was requested. A timeout counts as a failed
        attempt.

config SESSION_WIFI_JOIN_TIMEOUT_S
    int "Wi-Fi join timeout (seconds)"
    range 5 300
    default 30
    help
        Time allowed for joining the camera access point after the camera
        returned its Wi-Fi credentials, and for joining the home Wi-Fi for
        the backend uplink.

config SESSION_MAX_ATTEMPTS
    int "Attempts per camera"
    range 1 10
    default 3
    help
        A scan activates a camera at most this many times before giving up
        on it. A camera that answered over BLE but could not be read is then
        skipped and the scan goes on with the next one; if no camera was
        read, the hub returns to idle and the next scan comes with the next
        request or the schedule, which waits longer after failed scans.

config SESSION_MAX_CAMERAS
    int "Cameras per scan"
    range 1 4
    default 4
    help
        A scan reads one camera after the other: after each one it looks for
        a further camera over BLE, skipping those done in this scan, until
        none answers within SESSION_NEXT_CAMERA_TIMEOUT_S or this many are
        done. Then it syncs all of them in one check-in. With 1 a scan reads
        only the first camera that answers and spends no time looking for
        more.

config SESSION_NEXT_CAMERA_TIMEOUT_S
    int "Time to look for a further camera (seconds)"
    range 5 300
    default 20
    help
        After a camera is done, the scan looks this long for a further one
        over BLE. Each scan spends this time once after its last camera, so
        keep it short on battery; a camera is usually found within a few
        seconds when it is awake.

config SESSION_CAMERA_BUDGET_S
    int "Time budget for the cameras of one scan (seconds)"
    range 0 7200
    default 900
    help
        No further camera is started once the camera part of a scan has run
        this long; the cameras read so far are synced, the others wait for
        the next scan. A running camera session is not cut short. 0: no
        limit.

config SESSION_RETRY_DELAY_S
    int "Delay between camera attempts (seconds)"
    range 1 600
    default 10

endmenu

menu "Schedule"

config SCHEDULE_CAMERA_PLAN
    string "Camera read plan"
    default "*=120" if HUB_PROFILE_AUTONOMOUS
    default ""
    help
        When the hub reads the cameras on its own: time windows in local time
        (TIME_ZONE), each with an interval in minutes, and "*" for the rest
        of the day, for example
          05:00-09:00=30,17:00-22:00=30,*=120
        reads every 30 minutes at dawn and dusk and every two hours
        otherwise. An interval of 0 means no reads; an empty plan or "off"
        means no automatic reads at all. The first window that contains a
        time applies. Without a valid clock the windows are ignored and the
        "*" interval applies (if it is 0 or missing, the longest window
        interval). Each read wakes the camera's Wi-Fi for a minute or two,
        which costs its battery. A read is followed by a backend sync if the
        uplink is configured.
        Overridden by "config set camera_plan" (serial console, web
        installer) and by the backend.

config SCHEDULE_CHECKIN_INTERVAL_MIN
    int "Backend check-in interval (minutes, 0 = off)"
    range 0 1440
    default 30 if HUB_PROFILE_AUTONOMOUS
    default 0
    help
        How often the hub syncs with the backend between camera reads, to
        pick up commands from the app (for example a camera read on
        request) and upload what is left. Only with complete uplink
        settings; every camera read syncs as well and restarts the
        interval. Overridden by "config set checkin_min" and by the
        backend.

config SCHEDULE_START_DELAY_S
    int "Delay before the first scheduled cycle after power-on (seconds)"
    range 0 3600
    default 60
    help
        Gives the web installer and the serial console time before the
        first automatic camera read or check-in after a power-on or reset.
        Not applied after a wake-up from deep sleep.

config SCHEDULE_LOW_BATTERY_PERCENT
    int "Camera battery level that stretches the read interval (%, 0 = off)"
    range 0 100
    default 20

config SCHEDULE_LOW_BATTERY_FACTOR
    int "Read interval factor for a camera with a low battery"
    range 1 16
    default 3
    help
        Failed reads stretch the interval as well (2, 4, 8, 16 times after
        one to four failures in a row), and failed check-ins stretch the
        check-in interval in the same way, up to one day.

endmenu

menu "Power"

config POWER_DEEP_SLEEP
    bool "Deep sleep between cycles"
    default y if HUB_PROFILE_AUTONOMOUS
    default n
    help
        When nothing is due for at least POWER_MIN_SLEEP_S seconds, the hub
        goes into deep sleep until the next camera read or check-in. While
        it sleeps the serial console, a web UI and the display do not
        respond; press the reset button to wake it for
        POWER_AWAKE_AFTER_BOOT_MIN minutes.

config POWER_AWAKE_AFTER_BOOT_MIN
    int "Stay awake after a power-on or reset (minutes)"
    depends on POWER_DEEP_SLEEP
    range 0 120
    default 10

config POWER_AWAKE_AFTER_ACTIVITY_MIN
    int "Stay awake after a serial command (minutes)"
    depends on POWER_DEEP_SLEEP
    range 0 120
    default 5

config POWER_MIN_SLEEP_S
    int "Shortest deep sleep (seconds)"
    depends on POWER_DEEP_SLEEP
    range 10 3600
    default 60
    help
        If the next cycle is due sooner, the hub waits awake.

config POWER_MAX_SLEEP_MIN
    int "Longest deep sleep (minutes)"
    depends on POWER_DEEP_SLEEP
    range 10 1440
    default 720
    help
        The hub wakes up at least this often, even with nothing scheduled,
        and goes back to sleep after checking its schedule.

config UPLINK_WIFI_POWER_SAVE
    bool "Wi-Fi modem sleep on the home network"
    default y if HUB_PROFILE_AUTONOMOUS
    default n
    help
        Saves power during the backend sync over the home Wi-Fi at the cost
        of a slower transfer. The camera Wi-Fi never uses power save: in
        modem sleep, acknowledgements queue up and the camera stream runs
        out of transmit buffers.

endmenu

menu "Modem uplink"

config MODEM_UPLINK
    bool "Sync with the backend over the A7670E cellular modem"
    depends on IDF_TARGET_ESP32S3 && !BOARD_TDONGLE_S3
    default y
    help
        Drive the A7670E LTE modem of the Waveshare ESP32-S3-A7670E-4G on
        the S3's native USB port (USB host, PPP). It is switched on for a
        backend sync and off again afterwards. Which transport a hub uses is a
        setting ("config set transport wifi|modem"); without one the modem is
        used when no home Wi-Fi is set. The APN and the SIM PIN are settings
        too. On the board the USB DIP switch must be OFF (modem on the S3).
        See docs/modem.md.

config MODEM_POWER_GPIO
    int "GPIO that switches the modem's power (-1: DIP switch)"
    depends on MODEM_UPLINK
    range -1 48
    default -1
    help
        High switches the modem on. With -1 the modem's power comes from the
        4G DIP switch (ON): it stays powered and is put into flight mode
        (AT+CFUN=4) between syncs. Waveshare names GPIO33 for boards where
        the 4G DIP switch is OFF; check the board revision, GPIO33-37 are
        taken by the octal PSRAM of the ESP32-S3R8.

config MODEM_ATTACH_TIMEOUT_S
    int "Time allowed to get online over the modem (seconds)"
    depends on MODEM_UPLINK
    range 30 600
    default 120
    help
        From switching the modem on to an IP address: the modem starts,
        the SIM card is unlocked, the modem registers with the network and
        the data call is made. Without a home Wi-Fi this replaces the
        Wi-Fi join timeout of the uplink.

endmenu

menu "Hub battery"

config HUB_BATTERY_MAX17048
    bool "Measure the hub battery with a MAX17048 fuel gauge"
    default y if IDF_TARGET_ESP32S3 && !BOARD_TDONGLE_S3
    default n
    help
        Read the hub's battery from a MAX17048 fuel gauge on I2C, as on the
        Waveshare ESP32-S3-A7670E-4G. The level is sent in the check-in
        (hubBatPercent), shown by the console's status command and written
        to the memory log. Without a cell the gauge has no power and the
        level stays unknown. Boards without a gauge leave this off.

config HUB_BATTERY_I2C_SDA_GPIO
    int "I2C SDA GPIO of the gauge"
    depends on HUB_BATTERY_MAX17048
    default 15

config HUB_BATTERY_I2C_SCL_GPIO
    int "I2C SCL GPIO of the gauge"
    depends on HUB_BATTERY_MAX17048
    default 16

config HUB_BATTERY_PERCENT_FROM_VOLTAGE
    bool "Compute the percentage from the cell voltage"
    depends on HUB_BATTERY_MAX17048
    default n
    help
        Report a percentage from the cell voltage along a typical Li-ion
        curve between the empty and the full voltage below, instead of the
        gauge's own state of charge. The gauge's estimate is usually better
        (it is less affected by load peaks of the modem), but it needs some
        time to settle after the cell was inserted.

config HUB_BATTERY_EMPTY_MV
    int "Empty cell voltage (mV)"
    depends on HUB_BATTERY_PERCENT_FROM_VOLTAGE
    range 2500 4000
    default 3300

config HUB_BATTERY_FULL_MV
    int "Full cell voltage (mV)"
    depends on HUB_BATTERY_PERCENT_FROM_VOLTAGE
    range 3500 4500
    default 4200

endmenu

menu "SD card"

config SD_CARD_ENABLE
    bool "Mount the SD card at boot"
    default y
    help
        Mount the FAT file system of the microSD card at /sdcard using the
        SDMMC peripheral or, in SPI mode, an SPI bus. The card is never
        formatted automatically. On the ESP32-S3 boards the card is used in
        1-bit SDMMC mode on the GPIOs below; on the ESP32-P4-NANO it uses
        SDMMC slot 0 in 4-bit mode on its fixed IO MUX pins (CLK GPIO43, CMD
        GPIO44, D0-D3 GPIO39-42), powered by on-chip LDO channel 4. In SPI
        mode CLK is the SPI clock, CMD the MOSI and D0 the MISO line.

config SD_CARD_SPI_MODE
    bool "Use the card in SPI mode" if SOC_SDMMC_HOST_SUPPORTED
    depends on SD_CARD_ENABLE && !IDF_TARGET_ESP32P4
    default y if !SOC_SDMMC_HOST_SUPPORTED
    help
        Talk to the card over SPI2 instead of SDMMC. Required on chips
        without an SDMMC host (ESP32-C5). The bus may be shared with other
        devices such as a display.

config SD_CARD_CLK_GPIO
    int "CLK GPIO"
    depends on SD_CARD_ENABLE && !IDF_TARGET_ESP32P4
    range 0 48
    default 5

config SD_CARD_CMD_GPIO
    int "CMD GPIO"
    depends on SD_CARD_ENABLE && !IDF_TARGET_ESP32P4
    range 0 48
    default 4

config SD_CARD_D0_GPIO
    int "D0 GPIO"
    depends on SD_CARD_ENABLE && !IDF_TARGET_ESP32P4
    range 0 48
    default 6

config SD_CARD_CS_GPIO
    int "CS GPIO"
    depends on SD_CARD_SPI_MODE
    range 0 48
    default 23

config SD_CARD_LDO_CHANNEL
    int "On-chip LDO channel powering the card"
    depends on SD_CARD_ENABLE && IDF_TARGET_ESP32P4
    range 1 4
    default 4

endmenu

menu "Log on the SD card"
    depends on SD_CARD_ENABLE

config SD_LOG_ENABLE
    bool "Write the log to the SD card"
    default y
    help
        Copy every log line to /sdcard/logs/log-NNNNN.txt, so that a test
        run can be read afterwards (or live in the web UI) without a serial
        console. The lines are written every SD_LOG_FLUSH_INTERVAL_S seconds
        and synced to the card. A new file is started at every boot (but not
        at a wake-up from deep sleep, which continues the last file) and
        when a file reaches the size limit; the oldest files are removed.

config SD_LOG_FLUSH_INTERVAL_S
    int "Write interval (seconds)"
    depends on SD_LOG_ENABLE
    range 1 60
    default 10 if HUB_PROFILE_AUTONOMOUS
    default 1
    help
        Fewer, larger writes save power and wear of the card; pulling the
        card loses the lines of up to one interval. The log is written in
        full before the hub goes to sleep.

config SD_LOG_MAX_FILE_KB
    int "Maximum size of one log file (KB)"
    depends on SD_LOG_ENABLE
    range 64 65536
    default 4096

config SD_LOG_MAX_FILES
    int "Log files to keep"
    depends on SD_LOG_ENABLE
    range 2 1000
    default 50

config SD_LOG_BUFFER_KB
    int "Log buffer in PSRAM (KB)"
    depends on SD_LOG_ENABLE
    range 8 1024
    default 64
    help
        Holds the lines until they are written, including the boot messages
        before the card is mounted. Without PSRAM an 8 KB buffer in internal
        RAM is used.

endmenu


menu "Clock"

config TIME_ZONE
    string "Time zone (POSIX TZ rule)"
    default "CET-1CEST,M3.5.0,M10.5.0/3"
    help
        The time zone of the device, as the TZ rule of the C library: the name
        of the standard time and its offset from UTC (west of Greenwich
        positive, so "CET-1" is one hour east), then the summer time with the
        dates on which it starts and ends. The default is Central European
        Time and Summer Time. Rules for other zones: the TZ column of
        https://github.com/nayarsystems/posix_tz_db/blob/master/zones.csv
        The camera sets its clock at login. The TrailCam Go app gives it the
        local time of the phone, and the camera shows that time on its photos
        and videos as it is, so the device sends its local time too. Without
        a valid clock the login carries no time and the camera keeps its own.

config TIME_SYNC_SNTP
    bool "Set the clock by SNTP"
    default y
    help
        The clock is not set at boot. Without it, the time of a camera sync
        and the file times are not recorded, and the camera login carries no
        time, so the camera keeps its own clock. With this option the device asks an NTP server as soon as
        a network with internet access is up (Ethernet, or the home Wi-Fi
        during a backend sync) and then about once an hour. The backend sync
        sets the clock as well. Traffic goes to the server below only.

config TIME_SYNC_SERVER
    string "NTP server"
    depends on TIME_SYNC_SNTP
    default "pool.ntp.org"

config TIME_SYNC_BROWSER
    bool "Take the time of a browser that opens the web UI"
    depends on WEB_UI_ENABLE
    default y
    help
        The page sends the time of the computer or phone that shows it, when
        the clock of the device comes from no better source than that (SNTP
        or the backend replace it, and it replaces the camera's time). The
        camera gets it with the next login. Anyone who can reach the web UI
        can set the clock this way.

config TIME_SYNC_CAMERA
    bool "Take the time of the camera if there is no other"
    default y
    help
        When a session starts while the clock holds no time, the device takes
        the time that the camera reports (the clock it was last given, shown
        as local time and turned back to UTC with TIME_ZONE) and does not give
        it back to the camera. A time before the build of the firmware is not
        taken, but a camera clock that someone set wrong is: any other source
        replaces it.

endmenu

menu "Media download"
    depends on SD_CARD_ENABLE

config CAMERA_DOWNLOAD_PHOTOS
    bool "Download photos to the SD card"
    default n
    help
        After the thumbnails, download every photo of the camera's media
        list that is not on the SD card yet to /sdcard/<camera>/media/.
        The file is streamed to the card while it arrives, so it is never
        held in RAM. Videos are a separate option: the camera sends them
        only as a playback stream (cmdId 769), not as a file.

config CAMERA_DOWNLOAD_VIDEOS
    bool "Download videos (raw H.264 and AAC streams)"
    depends on SPIRAM
    default y if HUB_PROFILE_AUTONOMOUS
    default n
    help
        After the photos, play back the videos selected below that are not
        on the SD card yet (cmdId 769) and store their streams as
        /sdcard/<camera>/media/<dir>_<num>.h264 (H.264 Annex-B, playable
        with VLC) and .aac (AAC with ADTS headers). One MP4 can be made
        without re-encoding:
          ffmpeg -i 100_2.h264 -i 100_2.aac -c copy 100_2.mp4
        The camera streams the frames one by one; they are put in order in
        PSRAM and written through a 4 MB buffer in PSRAM. Verified on the
        T-Dongle-C5: a 15-second 1080p video takes about 31 s.

choice CAMERA_VIDEO_DOWNLOAD
    prompt "Which videos to download"
    depends on CAMERA_DOWNLOAD_VIDEOS
    default CAMERA_VIDEO_ON_REQUEST if HUB_PROFILE_AUTONOMOUS
    default CAMERA_VIDEO_ALL
    help
        A video costs the camera's battery (about twice its length of
        playback) and, when uploaded, data volume.

config CAMERA_VIDEO_ALL
    bool "Every video"
    help
        Every video of the media list that is not on the SD card yet.

config CAMERA_VIDEO_ON_REQUEST
    bool "Only videos requested in the app"
    help
        Only the videos asked for with "Download video" in the app or the
        bot. The request reaches the hub with the next check-in, which makes
        a camera read due at once; the video is uploaded with the sync after
        that read. A video that is no longer on the camera's card, or whose
        download failed three times, is reported as failed.

endchoice

config CAMERA_VIDEO_MAX_PER_SESSION
    int "Videos downloaded in one camera session (0: no limit)"
    depends on CAMERA_DOWNLOAD_VIDEOS
    range 0 100
    default 3 if CAMERA_VIDEO_ON_REQUEST
    default 0
    help
        The newest ones first; the rest follow in later sessions.

config UPLINK_VIDEO_MAX_MB
    int "Largest video uploaded to the backend (MB)"
    depends on CAMERA_DOWNLOAD_VIDEOS
    range 1 1000
    default 50
    help
        Requested videos are uploaded as MP4, built while they are sent from
        the stored H.264 and AAC files (nothing extra is stored). A larger
        one is reported as failed.

choice CAMERA_VIDEO_MP4
    prompt "MP4 files for downloaded videos"
    depends on CAMERA_DOWNLOAD_VIDEOS
    default CAMERA_VIDEO_MP4_ON_REQUEST if WEB_UI_ENABLE
    default CAMERA_VIDEO_MP4_NONE
    help
        The download stores each video as a raw .h264 and a .aac file, which
        players handle poorly (no duration, no index, no sound). This selects
        whether and how an MP4 with picture and sound is made from them.

config CAMERA_VIDEO_MP4_NONE
    bool "None"
    help
        Only the raw files.

config CAMERA_VIDEO_MP4_ON_REQUEST
    bool "Build when the web UI sends it"
    depends on WEB_UI_ENABLE
    help
        The web UI lists a <dir>_<num>.mp4 next to every video and builds it
        while it is downloaded, from the two stored files (copy only, no
        re-encoding). Nothing extra is stored and the download path does not
        change, but the file is built at every request, which takes a pass
        over the .h264 file before the first byte is sent. Requests are
        refused while a camera session is running. Range requests work, so
        players can seek. The frame rate comes from the duration of the audio
        track.

endchoice

config CAMERA_VIDEO_HEARTBEAT_INTERVAL_MS
    int "Heartbeat interval during a video download (ms)"
    depends on CAMERA_DOWNLOAD_VIDEOS
    range 100 3000
    default 1500
    help
        The camera does not pace the stream by the heartbeat: with 500 ms
        instead of 1.5 s a video downloaded at the same speed (see
        docs/video-download.md). Outside a video download the heartbeat is
        sent every 1.5 s.

config CAMERA_VIDEO_DISCARD_DATA
    bool "Throughput test: do not write videos to the SD card"
    depends on CAMERA_DOWNLOAD_VIDEOS
    default n
    help
        Receive, reorder, decrypt and parse every video as usual, but drop
        the data instead of writing it, and log the throughput per video
        ("Throughput test: ... KB/s"). Shows how fast the camera and the
        Wi-Fi link deliver without the SD card. Nothing is stored and no
        video is marked as downloaded, so the next normal session fetches
        them all. For measurements only.

config CAMERA_VIDEO_TRACE
    bool "Diagnostics: write a trace of every video's frames and ACKs"
    depends on CAMERA_DOWNLOAD_VIDEOS
    default n
    help
        Record every received playback frame (time, sequence, distance to
        the expected one, whether it starts an ARTEMIS record, whether a gap
        was open) and every sequence sent in an ACK, in PSRAM (up to 65536
        events, 768 KB), and write them after each video to
        /sdcard/<camera>/trace_<dir>_<num>.csv. Shows which frames the camera
        sends again and when they had been acknowledged. Writing the file
        takes about a second after each video.

config CAMERA_BULK_ACK_FRAMES
    int "Frames acknowledged in one ACK"
    range 1 64
    default 17
    help
        Received bulk frames (thumbnails, photos, videos) are acknowledged
        once each, this many in one ACK packet, as the TrailCam Go app does
        (17); an ACK is also sent when no frame arrived for 1 ms. Fewer
        frames per ACK tell the camera sooner what arrived, at the cost of
        more packets.

config CAMERA_DOWNLOAD_STALL_TIMEOUT_S
    int "Abort a download after this many seconds without data"
    depends on CAMERA_DOWNLOAD_PHOTOS || CAMERA_DOWNLOAD_VIDEOS
    range 5 300
    default 20
    help
        The partial file is removed and the next item is requested. The
        item is tried again in the next session.

endmenu

menu "Ethernet uplink"
    depends on SOC_EMAC_SUPPORTED

config ETH_UPLINK_ENABLE
    bool "Use wired Ethernet as the uplink"
    default y
    help
        Start the on-chip Ethernet MAC with the IP101 PHY at boot and obtain
        an address over DHCP. The Ethernet interface stays the default
        route while the camera Wi-Fi is joined. The GPIO defaults match the
        Waveshare ESP32-P4-NANO (RMII reference clock input on GPIO50).

config ETH_UPLINK_MDC_GPIO
    int "SMI MDC GPIO"
    depends on ETH_UPLINK_ENABLE
    range 0 54
    default 31

config ETH_UPLINK_MDIO_GPIO
    int "SMI MDIO GPIO"
    depends on ETH_UPLINK_ENABLE
    range 0 54
    default 52

config ETH_UPLINK_PHY_RST_GPIO
    int "PHY reset GPIO (-1: none)"
    depends on ETH_UPLINK_ENABLE
    range -1 54
    default 51

config ETH_UPLINK_PHY_ADDR
    int "PHY address"
    depends on ETH_UPLINK_ENABLE
    range 0 31
    default 1

endmenu

menu "Co-processor firmware"
    depends on IDF_TARGET_ESP32P4

config COPROCESSOR_UPDATE_ENABLE
    bool "Update the ESP32-C6 firmware at boot"
    default y
    help
        Build the ESP-Hosted firmware for the ESP32-C6 co-processor from the
        sources of the esp_hosted component and embed it in the application.
        At boot, the image is flashed to the C6 over the ESP-Hosted link if
        the C6 reports a different version, and the application restarts.
        The build then takes longer and the application grows by the size
        of the C6 image.

config COPROCESSOR_UPDATE_MAX_ATTEMPTS
    int "Update attempts per firmware version"
    depends on COPROCESSOR_UPDATE_ENABLE
    range 1 10
    default 3
    help
        Number of boots on which the same image is sent to the C6 before the
        firmware gives up and continues with the C6 firmware it has. The
        count is reset once the C6 runs the embedded version.

endmenu

menu "Web UI"

config WEB_UI_ENABLE
    bool "Serve a web UI"
    depends on !IDF_TARGET_ESP32P4 || ETH_UPLINK_ENABLE
    default n
    help
        Serve a web UI to start and stop the camera search, follow the
        status and the live log, and browse, view and download the files on
        the SD card. Boards with Wi-Fi only open their own WPA2 access point
        "TrailCamHub-XXXX" next to the camera station and serve it at
        http://10.42.0.1; while the camera Wi-Fi is joined, the access point
        uses the camera's channel, so clients are disconnected briefly when
        it changes. Needs about 40 KB of internal RAM. The ESP32-P4 serves
        it over its Ethernet port instead (see WEB_UI_OVER_ETHERNET).

config WEB_UI_OVER_ETHERNET
    bool
    depends on WEB_UI_ENABLE && IDF_TARGET_ESP32P4
    default y
    help
        Serve the web UI on the Ethernet interface at the address that the
        DHCP server of the network assigns, without an access point. The
        address is shown in the log ("Web UI at http://..."). The page asks
        for a password (HTTP Basic auth, any user name; see
        WEB_UI_ETHERNET_PASSWORD), which the log shows next to the address.
        HTTP is not encrypted: use it in a network you trust.

config WEB_UI_ETHERNET_PASSWORD
    string "Web UI password over Ethernet (empty: generate one)"
    depends on WEB_UI_OVER_ETHERNET
    default ""
    help
        At least 8 characters. When empty, a random password is generated
        at the first boot, stored in NVS and shown in the boot log with the
        address of the page.

config WEB_UI_AP_PASSWORD
    string "Access point password (empty: generate one)"
    depends on WEB_UI_ENABLE && !WEB_UI_OVER_ETHERNET
    default ""
    help
        At least 8 characters. When empty, a random password is generated
        at the first boot, stored in NVS and shown on the dongle display.

endmenu

menu "Firmware updates"

config OTA_AUTO_UPDATE
    bool "Install newer releases offered at the check-in"
    default y
    help
        The backend offers the newest GitHub release (tag vX.Y.Z) for this
        board and build variant. A hub that runs an older release downloads
        it over HTTPS into the other OTA slot, checks its size, SHA-256 and
        version, and restarts into it. The new firmware is kept once a
        check-in succeeds; a restart before that goes back to the old one,
        and that version is not installed again automatically. Development
        builds (a commit hash as version) are never replaced. See
        docs/ota.md.

config HUB_BOARD_ID
    string "Board name of the firmware images"
    default "tdongle-s3" if BOARD_TDONGLE_S3
    default "tdongle-c5" if BOARD_TDONGLE_C5
    default "esp32p4" if IDF_TARGET_ESP32P4
    default "esp32s3"
    help
        Names the image of a release that fits this board (the board names
        of the CI build matrix).

config HUB_BUILD_VARIANT
    string "Build variant of the firmware images"
    default "dev"
    help
        "dev" (INFO logging) or "release" (size-optimized, warnings only;
        set by sdkconfig.defaults.release). An update keeps the variant.

endmenu

menu "Serial console"

config HUB_CONSOLE_DIAGNOSTICS
    bool "Diagnostic commands (heap, ls, cat, rm, sdbench)"
    default y
    help
        Add commands to the serial console that show the internal RAM by
        capability and region, and list, read (as Base64 lines) and delete
        the files on the SD card and measure its write rate, so that a test
        run can be driven from a computer without taking out the card.
        tools/dongle_console.py runs commands and copies files. Files are
        not deleted while a scan uses the card.

endmenu

endmenu
