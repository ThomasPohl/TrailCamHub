# Board and preset of the build. The options of the other parts are in the
# Kconfig file of their component (menuconfig: Component config ->
# "TrailCamHub: ..."); docs/modes.md lists where each setting lives.
menu "TrailCamHub"

choice HUB_PROFILE
    prompt "Preset mode"
    default HUB_PROFILE_ON_SITE if BOARD_TDONGLE || IDF_TARGET_ESP32P4 || BOARD_S3_ETH || BOARD_ESP32_WROOM32D
    default HUB_PROFILE_AUTONOMOUS
    help
        The board's build sets what the hub can do (modem, Ethernet, battery
        gauge, web UI, display); how it is used is chosen at run time with
        the settings "power" (mains or battery) and "direction" (push or
        pull), stored in NVS (console "config set", web installer). This
        preset is the mode of a hub whose settings leave them empty. See
        docs/modes.md and docs/power-and-schedule.md.

config HUB_PROFILE_AUTONOMOUS
    bool "Battery + push (no one on site)"
    help
        Reads the cameras on a schedule, pushes to its destination (the
        backend) and sleeps (deep sleep) in between. After a power-on or
        reset the hub stays awake for a few minutes for the web installer
        and the serial console. Preset of the Waveshare
        ESP32-S3-A7670E-4G.

config HUB_PROFILE_ON_SITE
    bool "Mains + pull (person present, permanent power)"
    help
        Stays awake and waits for the button, the web UI or the serial
        console; no automatic reads or check-ins unless a schedule is set or
        the hub pushes to a configured destination. Preset of the T-Dongles
        and the ESP32-P4-NANO. Without a web UI in the build, the direction
        is push.

endchoice

config BOARD_TDONGLE_S3
    bool "LilyGO T-Dongle-S3 display and button"
    depends on IDF_TARGET_ESP32S3
    default n
    help
        Show the camera workflow status on the 0.96" display and use the
        button on the back (GPIO0) to search for the camera. Selected by
        sdkconfig.defaults.tdongle-s3.

config BOARD_TDONGLE_C5
    bool "LilyGO T-Dongle-C5 display and button"
    depends on IDF_TARGET_ESP32C5
    default n
    help
        Show the camera workflow status on the 0.96" display and use the
        button (GPIO28) to search for the camera. The display shares its
        SPI bus with the microSD card. Selected by
        sdkconfig.defaults.tdongle-c5.

config BOARD_S3_ETH
    bool "Waveshare ESP32-S3-ETH (W5500 Ethernet)"
    depends on IDF_TARGET_ESP32S3
    default n
    help
        Ethernet over the board's W5500, microSD in SPI mode, console on the
        native USB port; no modem and no battery gauge. Selected by
        sdkconfig.defaults.s3-eth.

config BOARD_ESP32_WROOM32D
    bool "ESP32-WROOM-32D with an SPI microSD reader"
    depends on IDF_TARGET_ESP32
    default n
    help
        Classic ESP32 dev board (4 MB flash, no PSRAM) with an external
        microSD breakout in SPI mode; console on UART0 through the board's
        USB-to-UART bridge. Mains power only. Selected by
        sdkconfig.defaults.wroom32d (#77).

config BOARD_TDONGLE
    bool
    default y if BOARD_TDONGLE_S3 || BOARD_TDONGLE_C5

endmenu
