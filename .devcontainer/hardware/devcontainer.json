// Second dev container configuration with access to boards on USB, for
// flashing and monitoring from inside the container ("Dev Containers: Rebuild
// and Reopen in Container" offers it next to the default one). The default
// configuration stays without device access, so it also works in Codespaces.
//
// The host's /dev is bind-mounted at /dev/host, so boards that are plugged in
// later, or that enumerate again after a reset (USB-Serial-JTAG), appear
// without a rebuild; post-start.sh links them to the usual names. It must not
// be mounted on /dev: the container would lose its own /dev/pts, and with
// rootless Docker every "docker exec -t" then fails (the host's /dev/pts/ptmx
// has mode 000). No --privileged: with rootful Docker, the device cgroup rules
// add only serial devices (ttyACM, ttyUSB) to Docker's defaults. Meant for
// rootless Docker, where the container's root is the host user, so the host
// user needs read and write access to the serial devices; see
// .devcontainer/hardware/README.md. Apart from that, keep this file in step
// with ../devcontainer.json.
{
  "name": "TrailCamHub ESP-IDF (USB boards)",
  "build": { "dockerfile": "../Dockerfile", "context": ".." },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/project,type=bind,consistency=cached",
  "workspaceFolder": "/project",
  "remoteUser": "root",
  "userEnvProbe": "loginInteractiveShell",
  "runArgs": [
    "--device-cgroup-rule=c 166:* rmw", // ttyACM: USB-Serial-JTAG (C5, S3, P4), CH343
    "--device-cgroup-rule=c 188:* rmw"  // ttyUSB: CH34x and other USB-UART bridges
  ],
  "containerEnv": {
    "IDF_PATH": "/opt/esp/idf",
    "IDF_CCACHE_ENABLE": "1",
    "CLAUDE_CONFIG_DIR": "/root/.claude"
  },
  "mounts": [
    "source=/dev,target=/dev/host,type=bind",
    // The bind mount is recursive: hide the host's terminals, shared memory
    // and message queues under it (they matter with rootful Docker, #113).
    // Docker orders mounts by depth, so these come after /dev/host.
    "target=/dev/host/pts,type=tmpfs",
    "target=/dev/host/shm,type=tmpfs",
    "target=/dev/host/mqueue,type=tmpfs",
    "source=trailcamhub-cache,target=/root/.cache,type=volume",
    "source=trailcamhub-claude,target=/root/.claude,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/hardware/post-start.sh"
}
