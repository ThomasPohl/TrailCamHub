menu "TrailCamHub: firmware updates"

config OTA_AUTO_UPDATE
    bool "Install newer releases from GitHub"
    default y
    help
        After a successful sync the hub reads the manifest of the newest
        GitHub release (tag vX.Y.Z) at most once a day. A hub that runs an
        older release downloads the image for its board and build variant
        over HTTPS into the other OTA slot, checks its size, SHA-256 and
        version, and restarts into it once the cycle is over. The new
        firmware is kept once a check-in succeeds; a restart before that
        goes back to the old one, and that version is not installed again
        automatically. Development builds (a commit hash as version) are
        never replaced. See docs/ota.md.

config OTA_MANIFEST_URL
    string "Manifest of the latest release"
    depends on OTA_AUTO_UPDATE
    default "https://github.com/ThomasPohl/TrailCamHub/releases/latest/download/ota.json"
    help
        ota.json of GitHub's "latest release" (written by the CI for every
        vX.Y.Z tag; pre-releases are skipped). A fork can point to its own
        releases.

config OTA_CHECK_INTERVAL_H
    int "Read the manifest at most every (hours)"
    depends on OTA_AUTO_UPDATE
    range 1 168
    default 24
    help
        One read costs roughly 10-20 KB (TLS and GitHub's redirect), which
        counts over the cellular modem. The console command "update" reads
        it at the next sync regardless.

config OTA_MIN_BATTERY_PERCENT
    int "Install only at or above this hub battery (%)"
    depends on OTA_AUTO_UPDATE
    range 0 100
    default 40
    help
        Unless the cell is being charged. Never in the low or critical
        level of the schedule (HUB_BATTERY_LOW_PERCENT and
        HUB_BATTERY_CRITICAL_PERCENT); without a battery measurement there
        is no limit.

config OTA_MODEM_MIN_SIGNAL_DBM
    int "Over the modem: install only at or above this signal (dBm)"
    depends on OTA_AUTO_UPDATE
    range -113 -51
    default -105
    help
        A weak signal makes a download of 1.5-2 MB slow and likely to
        break off.

config OTA_MAX_ATTEMPTS
    int "Failed installs of one version before waiting"
    depends on OTA_AUTO_UPDATE
    range 1 20
    default 3

config OTA_RETRY_AFTER_H
    int "Then wait this long before the next attempt (hours)"
    depends on OTA_AUTO_UPDATE
    range 1 168
    default 24

config HUB_BOARD_ID
    string "Board name of the firmware images"
    default "tdongle-s3" if BOARD_TDONGLE_S3
    default "tdongle-c5" if BOARD_TDONGLE_C5
    default "esp32p4" if IDF_TARGET_ESP32P4
    default "s3-eth" if BOARD_S3_ETH
    default "wroom32d" if BOARD_ESP32_WROOM32D
    default "esp32s3"
    help
        Names the image of a release that fits this board (the board names
        of the CI build matrix).

config HUB_BUILD_VARIANT
    string "Build variant of the firmware images"
    default "dev"
    help
        "dev" (INFO logging) or "release" (size-optimized, warnings only;
        set by sdkconfig.defaults.release). An update keeps the variant.

endmenu
