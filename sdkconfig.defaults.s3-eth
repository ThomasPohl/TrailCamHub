# Board: Waveshare ESP32-S3-ETH (ESP32-S3R8, 16 MB flash, 8 MB octal PSRAM,
# W5500 Ethernet on SPI, microSD slot, optional PoE module). Build with the
# esp32s3 target and
#   SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.s3-eth"
# so that these settings override the common and ESP32-S3 defaults (#136).

CONFIG_BOARD_S3_ETH=y

# Console: the native USB-C port (USB-Serial-JTAG).
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Ethernet over the W5500 (SPI3: SCLK GPIO13, MOSI GPIO11, MISO GPIO12,
# CS GPIO14, INT GPIO10, RST GPIO9) is the uplink.
CONFIG_ETH_UPLINK_ENABLE=y
CONFIG_ETH_UPLINK_W5500=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
# Use the DNS servers of the default interface so the camera's DHCP server
# cannot replace the Ethernet DNS servers.
CONFIG_ESP_NETIF_SET_DNS_PER_DEFAULT_NETIF=y

# microSD in SPI mode on SPI2: SCK GPIO7, MOSI GPIO6, MISO GPIO5, CS GPIO4.
CONFIG_SD_CARD_SPI_MODE=y
CONFIG_SD_CARD_CLK_GPIO=7
CONFIG_SD_CARD_CMD_GPIO=6
CONFIG_SD_CARD_D0_GPIO=5
CONFIG_SD_CARD_CS_GPIO=4

# Web UI on the Ethernet port (DHCP address and password in the boot log).
CONFIG_WEB_UI_ENABLE=y

# Download videos after the thumbnails; the web UI serves them as MP4.
CONFIG_CAMERA_DOWNLOAD_VIDEOS=y
