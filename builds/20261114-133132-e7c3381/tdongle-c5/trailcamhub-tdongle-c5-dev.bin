<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TrailCamHub</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<main>
  <header>
    <h1>TrailCamHub</h1>
    <span class="sub" id="ap"></span>
  </header>

  <section>
    <h2>Camera</h2>
    <div class="phase">
      <span class="pill idle" id="phase">вЂ¦</span>
      <span class="detail" id="detail"></span>
    </div>
    <div class="facts">
      <div><span>Camera Wi-Fi</span><b id="camera">вЂ“</b></div>
      <div><span>Media</span><b id="media">вЂ“</b></div>
      <div><span>Last sync</span><b id="lastsync">вЂ“</b></div>
      <div id="nextreadrow" hidden><span>Next scheduled read</span><b id="nextread">вЂ“</b></div>
      <div><span>Clock</span><b id="clock">вЂ“</b></div>
      <div><span>SD card free</span><b id="sd">вЂ“</b></div>
      <div><span>Uptime</span><b id="uptime">вЂ“</b></div>
    </div>
    <p class="note" id="clocknote" hidden>The clock of the dongle is not set, so
      the time of a sync cannot be recorded. Keep this page open: it gives the
      dongle the time of this device.</p>
    <progress id="progress" value="0" max="1" hidden></progress>
    <p class="actions">
      <button class="primary" id="search">Search camera</button>
      <button id="stop">Stop</button>
    </p>
    <p class="error" id="offline" hidden>No connection to the dongle.</p>
  </section>

  <section>
    <h2>Camera actions</h2>
    <p class="actions">
      <button id="act-photo">Take photo</button>
      <button id="act-vstart">Start video</button>
      <button id="act-vstop">Stop video</button>
    </p>
    <p class="actions">
      <input type="text" id="act-id" inputmode="numeric" maxlength="10"
        placeholder="mediaId" autocomplete="off"
        aria-label="mediaId of the recording to delete">
      <button id="act-delete">Delete recording</button>
      <button id="act-format">Erase camera SD card</button>
    </p>
    <p class="note" id="act-msg" hidden></p>
    <ul id="act-list"></ul>
  </section>

  <section>
    <h2>Files</h2>
    <div class="crumbs" id="crumbs"></div>
    <div class="listhead" id="listhead">
      <input type="search" id="filter" placeholder="Filter by nameвЂ¦"
        autocomplete="off" aria-label="Filter files">
      <span class="sorts" role="group" aria-label="Sort by">
        <button class="small" data-sort="name">Name</button>
        <button class="small" data-sort="size">Size</button>
        <button class="small" data-sort="mtime">Date</button>
      </span>
      <span class="count" id="count"></span>
    </div>
    <div class="list" id="files"></div>
  </section>

  <section>
    <div class="loghead">
      <h2>Log</h2>
      <span class="sub" id="logname"></span>
      <label><input type="checkbox" id="follow" checked> follow</label>
    </div>
    <pre id="log"></pre>
  </section>
</main>

<div id="viewer" hidden>
  <div class="top">
    <b id="vname"></b>
    <a class="button" id="vdownload">Download</a>
    <span id="vdelete"></span>
    <button id="vclose">Close</button>
  </div>
  <div class="body" id="vbody"></div>
</div>

<script src="/app.js"></script>
</body>
</html>
␀џ␀␀:root {
  --bg: #f4f5f2;
  --card: #ffffff;
  --text: #1d2420;
  --muted: #66706a;
  --line: #dde1dc;
  --accent: #2f6b4f;
  --accent-text: #ffffff;
  --busy: #a86b00;
  --ok: #2f7d4f;
  --warn: #b4442c;
  --danger: #b4442c;
  --danger-text: #ffffff;
  --code: #f0f2ee;
  --overlay: rgba(0, 0, 0, 0.82);
  --overlay-text: #ffffff;
  color-scheme: light;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #141816;
    --card: #1d2320;
    --text: #e4e8e5;
    --muted: #98a29c;
    --line: #2f3833;
    --accent: #5fae86;
    --accent-text: #0f1512;
    --busy: #e0a840;
    --ok: #6cc690;
    --warn: #ec7a5f;
    --danger: #ec7a5f;
    --danger-text: #1a0f0c;
    --code: #121614;
    color-scheme: dark;
  }
}

* {
  box-sizing: border-box;
}

[hidden] {
  display: none !important;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font: 15px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}

main {
  max-width: 860px;
  margin: 0 auto;
  padding: 16px;
}

/* Header */

header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}

h1 {
  margin: 0;
  font-size: 20px;
  letter-spacing: 0.01em;
}

h2 {
  margin: 0 0 10px;
  color: var(--muted);
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.sub {
  color: var(--muted);
  font-size: 13px;
}

section {
  margin-bottom: 14px;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--card);
}

/* Camera status */

.phase {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

.pill {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.03em;
}

.pill.idle { color: var(--text); }
.pill.busy { color: var(--busy); }
.pill.ok { color: var(--ok); }
.pill.warn { color: var(--warn); }

.detail {
  color: var(--muted);
}

.facts {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 8px 16px;
  margin: 12px 0;
}

.facts span {
  display: block;
  color: var(--muted);
  font-size: 12px;
}

.facts b {
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

progress {
  display: block;
  width: 100%;
  height: 6px;
  border: 0;
  border-radius: 3px;
  background: var(--line);
  accent-color: var(--accent);
  appearance: none;
  overflow: hidden;
}

progress::-webkit-progress-bar {
  background: var(--line);
}

progress::-webkit-progress-value {
  background: var(--accent);
}

progress::-moz-progress-bar {
  background: var(--accent);
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 12px 0 0;
}

.error {
  color: var(--warn);
}

/* Buttons */

button,
.button {
  display: inline-block;
  padding: 8px 14px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--card);
  color: var(--text);
  font: inherit;
  text-decoration: none;
  cursor: pointer;
}

button.primary {
  border-color: var(--accent);
  background: var(--accent);
  color: var(--accent-text);
  font-weight: 600;
}

button.danger {
  border-color: var(--danger);
  color: var(--danger);
}

/* Second step of a delete: the button asks for confirmation. */
button.danger.armed {
  background: var(--danger);
  color: var(--danger-text);
  font-weight: 600;
}

button:disabled {
  opacity: 0.5;
  cursor: default;
}

button.small {
  padding: 4px 10px;
  font-size: 13px;
}

/* File browser */

.crumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-bottom: 8px;
}

.crumbs a {
  color: var(--accent);
  text-decoration: none;
  cursor: pointer;
}

/* Filter and sort row above the list */

.listhead {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}

.listhead input {
  flex: 1 1 180px;
  min-width: 0;
  padding: 7px 10px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--card);
  color: var(--text);
  font: inherit;
}

.sorts {
  display: flex;
  gap: 4px;
}

button.small.sorted {
  border-color: var(--accent);
  color: var(--accent);
}

.count {
  color: var(--muted);
  font-size: 13px;
  white-space: nowrap;
}

.note {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.list {
  border-top: 1px solid var(--line);
}

.row .buttons {
  display: flex;
  flex: none;
  gap: 6px;
}

.name a {
  color: inherit;
  text-decoration: none;
}

.row {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  padding: 7px 2px;
  border-bottom: 1px solid var(--line);
  cursor: pointer;
}

.row:hover {
  background: color-mix(in srgb, var(--accent) 7%, transparent);
}

.icon {
  display: grid;
  place-items: center;
  flex: none;
  width: 52px;
  height: 40px;
  overflow: hidden;
  border-radius: 5px;
  background: var(--code);
  color: var(--muted);
  font-size: 12px;
}

.icon img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  color: var(--muted);
  font-size: 13px;
  font-variant-numeric: tabular-nums;
  text-align: right;
  white-space: nowrap;
}

.empty {
  padding: 10px 2px;
  color: var(--muted);
}

/* On phones the date is left out so that the name stays readable. */
@media (max-width: 520px) {
  .meta .date {
    display: none;
  }
}

/* Log */

.loghead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 8px;
}

.loghead h2 {
  margin: 0;
}

label {
  color: var(--muted);
  font-size: 13px;
}

pre {
  height: 340px;
  margin: 0;
  padding: 10px;
  overflow: auto;
  border-radius: 8px;
  background: var(--code);
  font: 12px/1.4 ui-monospace, Menlo, Consolas, monospace;
  white-space: pre-wrap;
  word-break: break-all;
}

/* Viewer overlay */

#viewer {
  position: fixed;
  inset: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  padding: 12px;
  background: var(--overlay);
}

#viewer .top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 10px;
  color: var(--overlay-text);
}

#viewer .top b {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

#viewer .body {
  display: grid;
  /* One cell of exactly the free space: without a definite size, the
     max-height of the video below does not apply, and a landscape video
     grows out of the window with its controls. */
  grid-template: minmax(0, 1fr) / minmax(0, 1fr);
  place-items: center;
  flex: 1;
  min-height: 0;
}

#viewer img,
#viewer video {
  max-width: 100%;
  max-height: 100%;
}

#viewer pre {
  width: 100%;
  height: 100%;
}

#viewer audio {
  width: min(480px, 100%);
}

#viewer .note {
  color: var(--overlay-text);
}
␀␀r␀␀"use strict";

const $ = (id) => document.getElementById(id);

const PHASES = {
  idle: ["READY", "idle", "Press вЂњSearch cameraвЂќ to look for the camera."],
  searching: ["SEARCHING", "busy", "Looking for the camera via Bluetooth."],
  connecting: ["CONNECTING", "busy", "Joining the camera Wi-Fi."],
  connected: ["CONNECTED", "ok", "Session running."],
  retry_wait: ["NO LINK", "warn", ""],
  uploading: ["UPLOADING", "busy", "Syncing with the backend over the home Wi-Fi."],
  finished: ["FINISHED", "ok", ""],
  listed: ["LISTED", "ok", ""],
  partial: ["INCOMPLETE", "warn", ""],
  not_found: ["NOT FOUND", "warn", "The camera was not reached. Search again to retry."],
  no_card: ["NO SD CARD", "warn", "The camera has no SD card, so there is nothing to read."],
  upload_failed: ["NO UPLOAD", "warn", "The home Wi-Fi was not reached; the data stays on the SD card."],
  stopped: ["STOPPED", "idle", "The search was stopped."],
};

// Phases in which no cycle runs.
const IDLE_PHASES = ["idle", "finished", "listed", "partial", "not_found", "no_card", "upload_failed", "stopped"];

// Path of the log file being written; it cannot be deleted.
let activeLog = "";

function size(bytes) {
  if (bytes < 1024) return bytes + " B";
  const units = ["KB", "MB", "GB"];
  let value = bytes / 1024;
  let unit = 0;
  while (value >= 1024 && unit < units.length - 1) {
    value /= 1024;
    unit++;
  }
  return value.toFixed(value < 10 ? 1 : 0) + " " + units[unit];
}

function duration(seconds) {
  const h = Math.floor(seconds / 3600);
  const m = Math.floor(seconds / 60) % 60;
  return h ? `${h} h ${m} min` : `${m} min ${seconds % 60} s`;
}

function fileUrl(path, download) {
  return "/files/" + path.split("/").map(encodeURIComponent).join("/") +
    (download ? "?download=1" : "");
}

function ext(name) {
  const match = name.match(/\.([^.]+)$/);
  return match ? match[1].toUpperCase().slice(0, 4) : "FILE";
}

function element(tag, className, text) {
  const node = document.createElement(tag);
  if (className) node.className = className;
  if (text !== undefined) node.textContent = text;
  return node;
}

// Files the firmware is still writing; the server refuses to delete them.
function deletable(path) {
  return path !== activeLog && !/\.(part|tmp)$/i.test(path);
}

// --- Status -----------------------------------------------------------------

// State-changing requests carry this header; the device refuses them without
// it, so other web pages cannot send them through the browser (CSRF).
const POST = { method: "POST", headers: { "X-TrailCamHub": "1" } };

async function post(url) {
  try {
    await fetch(url, POST);
  } catch (e) {
    // Shown by the next status poll.
  }
  refreshStatus();
}

async function refreshStatus() {
  try {
    const s = await (await fetch("/api/status")).json();
    $("offline").hidden = true;
    const [label, tone, text] = PHASES[s.phase] || [s.phase, "idle", ""];
    $("phase").textContent = label;
    $("phase").className = "pill " + tone;
    const total = s.media_total;
    const done = Math.min(s.media_done, total);
    const stored = Math.min(s.media_stored, total);
    if (s.phase === "retry_wait") {
      $("detail").textContent = `Next attempt in ${Math.ceil(s.retry_ms / 1000)} s.`;
    } else if (s.phase === "finished") {
      $("detail").textContent = total
        ? `Saved ${stored} of ${total} files. Search again for new media.`
        : "Camera synced. Search again for new media.";
    } else if (s.phase === "listed") {
      $("detail").textContent = `${total} file${total === 1 ? "" : "s"} on the camera. Nothing was saved or synced.`;
    } else if (s.phase === "partial") {
      $("detail").textContent = total
        ? `The session ended early: saved ${stored} of ${total} files. Search again for the rest.`
        : "The session ended early; some media were saved. Search again for the rest.";
    } else {
      $("detail").textContent = text;
    }
    $("camera").textContent = s.camera || "вЂ“";
    $("media").textContent =
      s.phase === "listed" ? `${total} on the camera` : total ? `${stored} of ${total} saved` : "вЂ“";
    $("progress").hidden = !total || s.phase === "finished" || s.phase === "partial" || s.phase === "listed";
    $("progress").max = total || 1;
    $("progress").value = done;
    $("sd").textContent = s.sd_total_mb
      ? `${size(s.sd_free_mb * 1048576)} of ${size(s.sd_total_mb * 1048576)}`
      : "no card";
    $("uptime").textContent = duration(s.uptime_s);
    // Only when a camera read plan is set on the dongle.
    $("nextreadrow").hidden = !(s.next_camera_s >= 0);
    if (s.next_camera_s >= 0) {
      $("nextread").textContent = s.next_camera_s > 0
        ? "in " + duration(s.next_camera_s)
        : "now";
    }
    showSync(s);
    syncClock(s);
    $("ap").textContent = s.ap;
    activeLog = s.log;
    const busy = ["searching", "connecting", "connected", "uploading"].includes(
      s.phase,
    );
    $("search").disabled = busy;
    $("stop").disabled = IDLE_PHASES.includes(s.phase);
  } catch (e) {
    $("offline").hidden = false;
  }
}

// --- Last sync --------------------------------------------------------------

// directory of a camera on the card -> time of its last sync
let cameraSync = {};
let cameraState = {};

function ago(seconds) {
  if (seconds < 90) return "just now";
  if (seconds < 5400) return Math.round(seconds / 60) + " min ago";
  if (seconds < 172800) return Math.round(seconds / 3600) + " h ago";
  return Math.round(seconds / 86400) + " days ago";
}

// t: Unix seconds; -1: synced but the time was not recorded; 0: never.
function syncText(t) {
  if (t > 0) {
    return new Date(t * 1000).toLocaleString() +
      " (" + ago(Date.now() / 1000 - t) + ")";
  }
  return t < 0 ? "done, time not recorded" : "never";
}

function showSync(s) {
  const before = JSON.stringify([cameraSync, cameraState]);
  cameraSync = {};
  cameraState = {};
  for (const camera of s.cameras || []) {
    cameraSync[camera.dir] = camera.last_sync;
    // "PH970S 2.3.6.5 В· battery 78 %, charging, 22 В°C"
    cameraState[camera.dir] = [[camera.model, camera.firmware].filter(Boolean).join(" "), camera.state]
      .filter(Boolean)
      .join(" В· ");
  }
  // The camera directories in the root of the card show their last sync.
  if (currentPath === "" && JSON.stringify([cameraSync, cameraState]) !== before) renderList();
  const cameras = s.cameras || [];
  // The most recent sync of any camera; with several cameras, say which.
  let latest = null;
  for (const camera of cameras) {
    if (!latest || camera.last_sync > latest.last_sync) latest = camera;
  }
  $("lastsync").textContent = latest ? syncText(latest.last_sync) : "вЂ“";
  $("lastsync").title = latest && cameras.length > 1 ? latest.id : "";
  $("clocknote").hidden = s.clock_source !== "none";
}

// --- Clock ------------------------------------------------------------------

const CLOCK_SOURCES = {
  sntp: "network time",
  backend: "backend",
  browser: "this browser",
  camera: "camera",
  none: "not set",
};

let timeSent = 0;

// The dongle has no clock of its own. If it got none from SNTP or the backend,
// this page tells it the time of this device (every half hour while open),
// and the dongle passes it on to the camera at the next login.
function syncClock(s) {
  const source = s.clock_source;
  $("clock").textContent = s.time
    ? `${new Date(s.time * 1000).toLocaleString()} (${CLOCK_SOURCES[source] || source})`
    : CLOCK_SOURCES[source] || source;
  if (source === "sntp" || source === "backend") return;
  const now = Date.now();
  if (now - timeSent < 30 * 60 * 1000) return;
  timeSent = now;
  fetch("/api/time?unix=" + Math.floor(now / 1000), POST).catch(
    () => {
      timeSent = 0;  // try again with the next status
    },
  );
}

// --- Delete -----------------------------------------------------------------

// Returns a two-step delete button: the first press asks, a second press
// within three seconds deletes.
function deleteButton(path, onDeleted) {
  const button = element("button", "danger small", "Delete");
  let timer = 0;
  button.onclick = async (event) => {
    event.stopPropagation();
    if (!button.classList.contains("armed")) {
      button.classList.add("armed");
      button.textContent = "Delete?";
      timer = setTimeout(() => {
        button.classList.remove("armed");
        button.textContent = "Delete";
      }, 3000);
      return;
    }
    clearTimeout(timer);
    button.disabled = true;
    try {
      const response = await fetch(
        "/api/delete?path=" + encodeURIComponent(path), POST);
      if (!response.ok) throw new Error(await response.text());
      onDeleted();
    } catch (e) {
      button.disabled = false;
      button.classList.remove("armed");
      button.textContent = "Failed";
    }
  };
  return button;
}

// --- Files ------------------------------------------------------------------

// The address names what is shown: "/" is the root of the card, "/browse/a/b"
// the directory or file a/b, and "?q=" the filter text. It can be bookmarked
// or sent to someone else.

const SORT_LABELS = { name: "Name", size: "Size", mtime: "Date" };

let currentPath = "";
let addressPath = "";
let entries = [];
let sortKey = "";
let sortDesc = false;
let filterText = "";

function browseUrl(path, filter) {
  const base = path ? "/browse/" + path.split("/").map(encodeURIComponent).join("/") : "/";
  return base + (filter ? "?q=" + encodeURIComponent(filter) : "");
}

function locationPath() {
  const match = location.pathname.match(/^\/browse\/(.*)$/);
  return match
    ? match[1].split("/").filter(Boolean).map(decodeURIComponent).join("/")
    : "";
}

function locationFilter() {
  return new URLSearchParams(location.search).get("q") || "";
}

function parentOf(path) {
  const slash = path.lastIndexOf("/");
  return slash < 0 ? "" : path.slice(0, slash);
}

function nameOf(path) {
  return path.slice(path.lastIndexOf("/") + 1);
}

// Puts the address in the history (replace: instead of a new entry).
function setAddress(path, replace, state) {
  addressPath = path;
  const url = browseUrl(path, filterText);
  if (location.pathname + location.search === url) return;
  history[replace ? "replaceState" : "pushState"](state || {}, "", url);
}

function showCrumbs(path) {
  const crumbs = $("crumbs");
  crumbs.replaceChildren();
  const parts = path ? path.split("/") : [];
  const add = (label, target) => {
    const link = element("a", "", label);
    link.href = browseUrl(target);
    link.onclick = (event) => {
      event.preventDefault();
      navigate(target);
    };
    crumbs.append(link);
  };
  add("SD card", "");
  parts.forEach((part, i) => {
    crumbs.append(" / ");
    add(part, parts.slice(0, i + 1).join("/"));
  });
}

function fileRow(path, entry, thumbDir) {
  const full = path ? path + "/" + entry.name : entry.name;
  const row = element("div", "row");

  const icon = element("div", "icon");
  if (!entry.dir && thumbDir && !/\.part$/i.test(entry.name)) {
    const img = element("img");
    img.loading = "lazy";
    img.alt = "";
    img.src = fileUrl(thumbDir + "/" + entry.name.replace(/\.[^.]+$/, "") + ".jpg");
    img.onerror = () => {
      icon.textContent = ext(entry.name);
    };
    icon.append(img);
  } else {
    icon.textContent = entry.dir ? "DIR" : ext(entry.name);
  }

  const name = element("div", "name");
  const link = element("a", "", entry.name);
  link.href = browseUrl(full);
  name.append(link);

  const meta = element("div", "meta");
  if (!entry.dir) {
    meta.append(size(entry.size));
    if (entry.mtime > 1e9) {
      meta.append(element("span", "date",
        " В· " + new Date(entry.mtime * 1000).toLocaleString()));
    }
  } else if (path === "" && full in cameraSync) {
    meta.append("synced: " + syncText(cameraSync[full]) + (cameraState[full] ? " В· " + cameraState[full] : ""));
  }

  row.append(icon, name, meta);
  if (!entry.dir) {
    const buttons = element("div", "buttons");
    const download = element("a", "button small", "Download");
    download.href = fileUrl(full, true);
    download.onclick = (event) => event.stopPropagation();
    buttons.append(download);
    if (deletable(full)) {
      buttons.append(deleteButton(full, () => {
        entries = entries.filter((e) => e !== entry);
        row.remove();
        showCount();
      }));
    }
    row.append(buttons);
  }
  const open = () => (entry.dir ? navigate(full) : openFile(full, entry.name));
  row.onclick = open;
  link.onclick = (event) => {
    event.preventDefault();
    event.stopPropagation();
    open();
  };
  return row;
}

function visibleEntries() {
  const needle = filterText.trim().toLowerCase();
  const list = entries.filter((e) => !needle || e.name.toLowerCase().includes(needle));
  const byName = (a, b) => a.name.localeCompare(b.name, undefined, { numeric: true });
  const direction = sortDesc ? -1 : 1;
  list.sort((a, b) => {
    if (a.dir !== b.dir) return b.dir - a.dir;  // directories first
    if (sortKey === "name") return direction * byName(a, b);
    if (sortKey === "size") return direction * (a.size - b.size) || byName(a, b);
    if (sortKey === "mtime") return direction * (a.mtime - b.mtime) || byName(a, b);
    return (b.mtime - a.mtime) || byName(a, b);
  });
  return list;
}

function showCount() {
  const shown = document.querySelectorAll("#files .row").length;
  $("count").textContent = filterText.trim()
    ? `${shown} of ${entries.length}`
    : `${entries.length} ${entries.length === 1 ? "item" : "items"}`;
}

function renderList() {
  const list = $("files");
  list.replaceChildren();
  for (const button of document.querySelectorAll("#listhead [data-sort]")) {
    const active = button.dataset.sort === sortKey;
    button.classList.toggle("sorted", active);
    button.textContent = SORT_LABELS[button.dataset.sort] +
      (active ? (sortDesc ? " в–ј" : " в–І") : "");
  }
  $("filter").value !== filterText && ($("filter").value = filterText);
  const visible = visibleEntries();
  // Photos and videos in media/ have a thumbnail with the same base name in
  // thumb/ next to it.
  const thumbDir = /(^|\/)media$/.test(currentPath) ? currentPath.replace(/media$/, "thumb")
    : /(^|\/)thumb$/.test(currentPath) ? currentPath : null;
  for (const entry of visible) {
    list.append(fileRow(currentPath, entry, thumbDir));
  }
  if (!visible.length) {
    list.append(element("div", "empty", entries.length ? "No file matches." : "Empty."));
  }
  showCount();
}

// The listing of a directory; null if there is none, undefined if the dongle
// could not be reached.
async function listDirectory(path) {
  try {
    const response = await fetch("/api/files?path=" + encodeURIComponent(path));
    return response.ok ? await response.json() : null;
  } catch (e) {
    return undefined;
  }
}

// Shows what `path` names: a directory, or a file in a directory (which opens
// in the viewer).
async function show(path) {
  const data = await listDirectory(path);
  const dir = data ? path : parentOf(path);
  const listing = data || (await listDirectory(dir));
  currentPath = dir;
  showCrumbs(dir);
  entries = listing
    ? listing.entries.filter((e) => e.name !== "." && e.name !== "..")
    : [];
  renderList();
  if (data) {
    hideViewer();
    return;
  }
  const entry = entries.find((e) => e.name === nameOf(path) && !e.dir);
  if (entry) {
    view(path, entry.name);
  } else {
    hideViewer();
    $("files").replaceChildren(element("div", "empty",
      listing === undefined ? "Could not read the directory." : `Not found: ${path}`));
  }
}

// A click on a directory: new history entry, filter cleared.
function navigate(path) {
  filterText = "";
  setAddress(path, false);
  return show(path);
}

function openDir(path) {
  return show(path);
}

function openFile(path, name) {
  setAddress(path, false, { viewer: true });
  return view(path, name);
}

// --- Viewer -----------------------------------------------------------------

function hideViewer() {
  $("viewer").hidden = true;
  $("vbody").replaceChildren();
}

// The close button: back to the directory's address.
function closeViewer() {
  if (history.state && history.state.viewer) {
    history.back();  // popstate hides the viewer
    return;
  }
  setAddress(currentPath, true);
  hideViewer();
}

async function view(path, name) {
  const body = $("vbody");
  body.replaceChildren();
  $("vname").textContent = name;
  $("vdownload").href = fileUrl(path, true);
  const remove = $("vdelete");
  remove.replaceChildren();
  if (deletable(path)) {
    remove.append(deleteButton(path, () => {
      setAddress(currentPath, true);
      show(currentPath);
    }));
  }
  const lower = name.toLowerCase();
  if (/\.jpe?g$/.test(lower)) {
    const img = element("img");
    img.src = fileUrl(path);
    body.append(img);
  } else if (/\.(mp4|mov)$/.test(lower)) {
    const video = element("video");
    video.src = fileUrl(path);
    video.controls = true;
    body.append(video);
  } else if (/\.aac$/.test(lower)) {
    const audio = element("audio");
    audio.src = fileUrl(path);
    audio.controls = true;
    body.append(audio);
  } else if (/\.(txt|csv|log|json)$/.test(lower)) {
    const pre = element("pre", "", "LoadingвЂ¦");
    body.append(pre);
    try {
      pre.textContent = await (await fetch(fileUrl(path))).text();
    } catch (e) {
      pre.textContent = "Could not load the file.";
    }
  } else {
    // Raw H.264 streams play in VLC; see the README for making an MP4.
    body.append(element("p", "note", /\.h264$/.test(lower)
      ? "Raw H.264 video: download it and open it with VLC."
      : "No preview for this file type."));
  }
  $("viewer").hidden = false;
}

// --- Live log ---------------------------------------------------------------

let logOffset = -1;
let logPath = "";

async function refreshLog() {
  if (!$("follow").checked) return;
  try {
    const response = await fetch("/api/log?offset=" + logOffset);
    const path = response.headers.get("X-Log-Path") || "";
    const text = await response.text();
    const pre = $("log");
    if (path !== logPath) {
      if (logPath) pre.textContent += `\n--- ${path} ---\n`;
      logPath = path;
      $("logname").textContent = path;
      if (logOffset >= 0) {
        logOffset = -1;
        return;
      }
    }
    logOffset = parseInt(response.headers.get("X-Log-Size") || "0", 10);
    if (text) {
      const atBottom = pre.scrollTop + pre.clientHeight >= pre.scrollHeight - 20;
      pre.textContent += text;
      // Keep the view small on phones.
      if (pre.textContent.length > 200000) {
        pre.textContent = pre.textContent.slice(-150000);
      }
      if (atBottom) pre.scrollTop = pre.scrollHeight;
    }
  } catch (e) {
    // Retried with the next poll.
  }
}

// --- Camera actions ---------------------------------------------------------

function showActionMessage(text, isError) {
  const message = $("act-msg");
  message.hidden = false;
  message.textContent = text;
  message.classList.toggle("error", !!isError);
}

// Photo, video, delete and format. The hub answers delete and format with a
// code first; the page asks the person and repeats the request with it.
async function runAction(type, id) {
  const url = "/api/action?type=" + type + (id ? "&id=" + id : "");
  try {
    let reply = await (await fetch(url, POST)).json();
    if (reply.needsCode) {
      if (!window.confirm(reply.text + ". Continue?")) {
        showActionMessage("Cancelled.");
        return;
      }
      reply = await (await fetch(url + "&code=" + reply.code, POST)).json();
    }
    showActionMessage(reply.text || (reply.ok ? "Queued." : "Failed."), !reply.ok);
  } catch (e) {
    showActionMessage("No connection to the hub.", true);
  }
  refreshActions();
  refreshStatus();
}

async function refreshActions() {
  try {
    const list = (await (await fetch("/api/actions")).json()).actions || [];
    const items = $("act-list");
    items.textContent = "";
    for (const action of list.slice(-6)) {
      const item = document.createElement("li");
      item.textContent = "#" + action.id + " " + action.text;
      items.appendChild(item);
    }
  } catch (e) {
    // Retried with the next poll.
  }
}

$("act-photo").onclick = () => runAction("photo");
$("act-vstart").onclick = () => runAction("video-start");
$("act-vstop").onclick = () => runAction("video-stop");
$("act-format").onclick = () => runAction("format");
$("act-delete").onclick = () => {
  const id = $("act-id").value.trim();
  if (!/^[1-9][0-9]{0,9}$/.test(id)) {
    showActionMessage("Enter the mediaId of the recording (see the file names).", true);
    return;
  }
  runAction("delete", id);
};

// --- Start ------------------------------------------------------------------

$("search").onclick = () => post("/api/search");
$("stop").onclick = () => post("/api/stop");
$("vclose").onclick = closeViewer;

$("filter").oninput = () => {
  filterText = $("filter").value;
  renderList();
  // The filter is part of the address, without a history entry of its own.
  history.replaceState(history.state, "", browseUrl(addressPath, filterText));
};
for (const button of document.querySelectorAll("#listhead [data-sort]")) {
  button.onclick = () => {
    const key = button.dataset.sort;
    sortDesc = sortKey === key ? !sortDesc : key !== "name";
    sortKey = key;
    renderList();
  };
}

window.onpopstate = () => {
  filterText = locationFilter();
  addressPath = locationPath();
  show(addressPath);
};

refreshStatus();
filterText = locationFilter();
addressPath = locationPath();
show(addressPath);
refreshLog();
refreshActions();
setInterval(refreshStatus, 2000);
