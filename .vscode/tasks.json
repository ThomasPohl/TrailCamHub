{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP-IDF: Build firmware",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source \"$IDF_PATH/export.sh\" >/dev/null && idf.py build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
