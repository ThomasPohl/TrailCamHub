# Settings shared by all supported boards. Board-specific settings are in
# sdkconfig.defaults.<target>, which ESP-IDF applies on top of this file:
#   esp32s3: Waveshare ESP32-S3-A7670E-4G
#   esp32p4: Waveshare ESP32-P4-NANO

# Flash and partitions
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM. Larger allocations, Wi-Fi/lwIP buffers, mbedTLS and the NimBLE host
# are placed in PSRAM so the internal SRAM stays available for DMA,
# interrupt handlers and the radio controllers. Booting stops with an
# error if the PSRAM cannot be initialized. The PSRAM mode is set per target.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Core dumps are stored in the coredump partition for post-mortem analysis
# (idf.py coredump-info).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Bluetooth LE: NimBLE host as central/GATT client only, one connection,
# no pairing, legacy (BLE 4.2) scanning. The host allocates from PSRAM.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
# CONFIG_BT_NIMBLE_ROLE_PERIPHERAL is not set
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
# CONFIG_BT_NIMBLE_GATT_SERVER is not set
# CONFIG_BT_NIMBLE_SECURITY_ENABLE is not set
# CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# FAT file system on the SD card: long file names for camera media.
CONFIG_FATFS_LFN_HEAP=y
# FAT at the SD card's sector size (there is no FAT in flash, which needs
# 4096): 512-byte instead of 4 KB buffers per volume and open file.
CONFIG_FATFS_SECTOR_512=y
