# Board: Waveshare ESP32-S3-A7670E-4G (ESP32-S3R8, 16 MB flash,
# 8 MB octal PSRAM in package).

# Flash and partitions
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM. Larger allocations, Wi-Fi/lwIP buffers, mbedTLS and the Bluedroid
# host are placed in PSRAM so the 512 KB internal SRAM stays available for
# DMA, interrupt handlers and the radio controllers. Booting stops with an
# error if the PSRAM cannot be initialized.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y

# Console: UART0 only. The native USB of the ESP32-S3 is wired to the A7670E
# modem, so the USB-Serial-JTAG console is not reachable on this board.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Core dumps are stored in the coredump partition for post-mortem analysis
# (idf.py coredump-info).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Bluetooth LE (Bluedroid, GATT client)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_GATTC_ENABLE=y

# FAT file system on the SD card: long file names for camera media.
CONFIG_FATFS_LFN_HEAP=y
