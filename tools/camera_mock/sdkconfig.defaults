# Camera mock: settings shared by all chips. Chip-specific ones are in
# sdkconfig.defaults.esp32 and sdkconfig.defaults.esp32s3, which ESP-IDF adds
# for the target set with `set-target` or `-D IDF_TARGET=...`.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Wi-Fi and NimBLE together do not fit the default 1 MB app partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# BLE peripheral only, like the camera.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="TC100_0CFB"

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
