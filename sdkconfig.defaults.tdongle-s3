# Board: LilyGO T-Dongle-S3 (ESP32-S3, 16 MB flash, no PSRAM, 0.96" ST7735
# display, button on GPIO0, microSD slot). Build with the esp32s3 target and
#   SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.tdongle-s3"
# so that these settings override the common and ESP32-S3 defaults.

CONFIG_BOARD_TDONGLE_S3=y

# Searching starts with a press of the button (CONFIG_SESSION_SCAN_ON_BOOT and
# the automatic scan interval are off by default).

# No PSRAM on this board: keep everything in internal RAM.
# CONFIG_SPIRAM is not set
# CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC is not set
# CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL is not set
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y

# Console: the native USB port (USB-Serial-JTAG) is the only serial link.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# microSD slot in 1-bit SDMMC mode.
CONFIG_SD_CARD_CLK_GPIO=12
CONFIG_SD_CARD_CMD_GPIO=16
CONFIG_SD_CARD_D0_GPIO=14

# Download photos to the SD card after the thumbnails.
CONFIG_CAMERA_DOWNLOAD_PHOTOS=y

# Queue more camera frames while an SD card write blocks the session task
# (default 6); frames that still do not fit are resent by the camera.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16

# The thumbnails are on the SD card; no Base64 copy in the log.
# CONFIG_CAMERA_THUMBNAIL_SERIAL_PREVIEW is not set
